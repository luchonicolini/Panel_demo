{
  "name": "nicolini-import-starter",
  "version": "1.0.0",
  "private": true,
  "description": "Starter de e-commerce con panel de administración, catálogo público y venta por WhatsApp. Supabase + Next.js.",
  "author": "Luciano Nicolini (https://github.com/luchonicolini)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/luchonicolini/Panel_demo.git"
  },
  "homepage": "https://github.com/luchonicolini/Panel_demo#readme",
  "bugs": {
    "url": "https://github.com/luchonicolini/Panel_demo/issues"
  },
  "keywords": [
    "nextjs",
    "react",
    "typescript",
    "tailwindcss",
    "supabase",
    "ecommerce",
    "admin-dashboard",
    "whatsapp",
    "astryx",
    "playwright",
    "vitest"
  ],
  "engines": {
    "node": ">=22.13.0",
    "npm": ">=10"
  },
  "overrides": {
    "postcss": "$postcss"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:ui": "playwright test --ui",
    "seed:admin": "node scripts/bootstrap-admin.mjs"
  },
  "dependencies": {
    "@astryxdesign/core": "^0.7.17",
    "@astryxdesign/theme-neutral": "^0.7.17",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@stylexjs/stylex": "^0.19.2",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.58.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.577.0",
    "next": "15.5.29",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.6.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astryxdesign/cli": "^0.7.17",
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.29",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.9.2",
    "vitest": "^4.1.12"
  }
}
