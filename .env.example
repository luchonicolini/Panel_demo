# ---------------------------------------------------------------------------
# Nicolini Import starter — variables de entorno
# Copiá este archivo como .env.local y completá los valores de tu proyecto.
# ---------------------------------------------------------------------------

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=TU_ANON_KEY

# SOLO servidor. Nunca expongas esta clave con el prefijo NEXT_PUBLIC_.
# Se usa únicamente para el script de bootstrap del primer administrador.
SUPABASE_SERVICE_ROLE_KEY=

# Opcional: forzar el modo demo local aunque haya credenciales de Supabase.
# En desarrollo se activa solo si falta Supabase. En producción NO se activa
# implícitamente: si falta Supabase y DEMO_MODE no es true, el servidor falla.
# Dejalo comentado en desarrollo para que la demo se active sola sin Supabase.
# DEMO_MODE=false

# Credenciales del administrador en modo demo (por defecto demo1234).
# En producción con DEMO_MODE=true son obligatorias y deben ser propias.
DEMO_ADMIN_EMAIL=demo@nicoliniimport.com
DEMO_ADMIN_PASSWORD=demo1234

# Secreto para firmar la cookie del modo demo. En desarrollo, si queda vacío se
# usa uno local. En producción con DEMO_MODE=true es obligatorio: 32+ caracteres
# y distinto de los valores de ejemplo.
DEMO_AUTH_SECRET=

# Solo para tests E2E: aíslan la base y las fotos de tus datos locales.
# DEMO_DATA_DIR=.data/e2e
# DEMO_UPLOADS_NAMESPACE=e2e

# URL pública usada en mensajes de WhatsApp y metadatos (opcional).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
